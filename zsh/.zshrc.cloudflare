source /opt/homebrew/opt/spaceship/spaceship.zsh
source <(fzf --zsh)

# Lazy-load zoxide for faster startup (~300ms saved)
z() {
  unset -f z 2>/dev/null
  eval "$(zoxide init zsh)"
  z "$@"
}

alias l="ls -alh"
alias vim=nvim

# opencode
export PATH=/Users/broy/.opencode/bin:$PATH

# Hardcoded Node path for instant startup (FNM removed - saves ~500ms)
export PATH="$HOME/.nvm/versions/node/v22.22.0/bin:$PATH"

# Lazy-load fnm command when needed
fnm() {
  unset -f fnm
  eval "$(fnm env --use-on-cd)"
  fnm "$@"
}

# pnpm
export PNPM_HOME="/Users/broy/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# Initialize the completion system with caching for faster startup
autoload -Uz compinit
# Only rebuild completion cache once per day for faster shell startup
if [[ -n ${ZDOTDIR}/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

# Allow "approximate" matching and case-insensitivity (optional but highly recommended)
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'

# CMake for arroyo
export PATH=$PATH:/Applications/CMake.app/Contents/bin

export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
export PATH="$HOME/go/bin/:$PATH"

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000000
SAVEHIST=10000000
setopt EXTENDED_HISTORY
setopt INC_APPEND_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_SAVE_NO_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY
setopt HIST_BEEP

export VAULT_ADDR=https://vault.cfdata.org:8200
